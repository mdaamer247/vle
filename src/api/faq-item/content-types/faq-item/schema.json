{
  "kind": "collectionType",
  "collectionName": "faq_items",
  "info": {
    "singularName": "faq-item",
    "pluralName": "faq-items",
    "displayName": "FAQ Item",
    "description": "Individual FAQ question and answer item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "question": {
      "type": "string",
      "required": true
    },
    "answer": {
      "type": "richtext",
      "required": true
    },
    "order": {
      "type": "integer",
      "required": false,
      "default": 0
    },
    "faq_category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::faq-category.faq-category"
    }
  }
}
