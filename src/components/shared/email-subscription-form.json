			"type": "enumeration",
			"enum": ["black", "dark-grey", "blue", "orange"],
			"required": false,
			"default": "black"
		},
		"buttonTextColor": {
			"type": "enumeration",
			"enum": ["white", "black", "blue", "orange"],
			"required": false,
			"default": "white"
		},
		"formStyle": {
