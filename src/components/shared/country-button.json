{
  "collectionName": "components_shared_country_buttons",
  "info": {
    "name": "Country Button",
    "icon": "flag",
    "displayName": "Country Button",
    "description": "Individual country/region button with flag and name"
  },
  "options": {},
  "attributes": {
    "countryName": {
      "type": "string",
      "required": true
    },
    "flagIcon": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "countryCode": {
      "type": "string",
      "required": false
    },
    "backgroundColor": {
      "type": "enumeration",
      "enum": [
        "off-white",
        "light-grey",
        "white",
        "beige"
      ],
      "required": false,
      "default": "off-white"
    },
    "textColor": {
      "type": "enumeration",
      "enum": [
        "black",
        "dark-grey",
        "blue",
        "green"
      ],
      "required": false,
      "default": "black"
    },
    "isAvailable": {
      "type": "boolean",
      "required": false,
      "default": true
    }
  }
}
