{
  "collectionName": "components_shared_social_media_links",
  "info": {
    "name": "Social Media Link",
    "icon": "share",
    "displayName": "Social Media Link",
    "description": "Social media link with icon and URL"
  },
  "options": {},
  "attributes": {
    "platform": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "facebook",
        "twitter",
        "instagram",
        "youtube",
        "linkedin"
      ]
    },
    "url": {
      "type": "string",
      "required": true
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    }
  }
}
