{
	"collectionName": "components_shared_buttons",
	"info": {
		"name": "Button",
		"icon": "cursor",
		"displayName": "Button",
		"description": "Button component for CTAs"
	},
	"options": {},
	"attributes": {
		"text": {
			"type": "string",
			"required": true
		},
		"url": {
			"type": "string",
			"required": false
		},
		"style": {
			"type": "enumeration",
			"enum": ["primary", "secondary", "outline"],
			"default": "primary"
		},
		"size": {
			"type": "enumeration",
			"enum": ["small", "medium", "large"],
			"default": "medium"
		},
		"target": {
			"type": "enumeration",
			"enum": ["_self", "_blank"],
			"default": "_self"
		}
	}
}
