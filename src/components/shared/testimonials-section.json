{
  "collectionName": "components_shared_testimonials_sections",
  "info": {
    "name": "Testimonials Section",
    "icon": "quote",
    "displayName": "Testimonials Section",
    "description": "Customer testimonials section with carousel navigation"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "testimonials": {
      "type": "component",
      "repeatable": true,
      "component": "shared.testimonial-item",
      "required": true
    },
    "showNavigation": {
      "type": "boolean",
      "required": false,
      "default": true
    },
    "backgroundColor": {
      "type": "enumeration",
      "enum": [
        "white",
        "light-grey",
        "beige",
        "off-white"
      ],
      "required": false,
      "default": "white"
    },
    "testimonialBackgroundColor": {
      "type": "enumeration",
      "enum": [
        "beige",
        "light-grey",
        "off-white",
        "white"
      ],
      "required": false,
      "default": "beige"
    }
  }
}
